# Copy this file to .env and fill in the key. .env is not committed to Git.

# Optional AI reading of vendor documents through OpenCode Go
# (https://opencode.ai/docs/go/). Leave the key empty to keep AI reading off.
# Get a key from the OpenCode console.
OPENCODE_API_KEY=

# Model and address; the defaults are shown.
# AI_MODEL=deepseek-v4.1-flash
# AI_BASE_URL=https://opencode.ai/inference/go/openai/v1

# PORT=3000
# DATA_DIR=./data
